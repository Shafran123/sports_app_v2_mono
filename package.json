{
  "name": "myslot",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@8.6.12",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:user": "pnpm --filter @myslot/user dev",
    "dev:admin": "pnpm --filter @myslot/admin dev",
    "dev:landing": "pnpm --filter @myslot/landing dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:ui": "turbo run test:ui",
    "e2e": "pnpm --dir e2e e2e",
    "e2e:ui": "pnpm --dir e2e e2e:ui",
    "e2e:headed": "pnpm --dir e2e e2e:headed",
    "e2e:install": "pnpm --dir e2e install && pnpm --dir e2e install:browsers",
    "e2e:report": "pnpm --dir e2e e2e:report"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  }
}