# Backend Environment Variables
# Copy this to .env and fill in your values

# Server
PORT=2400

# PostgreSQL database
DATABASE_URL=postgres://localhost:5432/sports_dev

# Firebase Admin SDK
# Path to the Firebase service account JSON (downloaded from Firebase console, never committed)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json

# Mailgun (Email notifications)
# Get your API key from https://app.mailgun.com — free tier includes 100 emails/month
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAILGUN_DOMAIN=mg.yourdomain.com

# Email settings
FROM_EMAIL=MySlot.LK <no-reply@yourdomain.com>
ADMIN_EMAIL=admin@yourdomain.com

# SMSGo.lk (SMS notifications — booking lifecycle: confirmation, reminder,
# cancellations, walk-ins, event registration/cancellation + phone OTP codes)
# Get your API key from https://smsgo.lk
SMSGO_API_KEY=sg_live_xxxxxxxxxxxxxxxx
SMSGO_MASK=MYSLOT

# Frontend URL (for CORS + PayHere return_url, QR links, email bases)
FRONTEND_URL=http://localhost:3000
# Venue-owner console origin (for owner-facing email CTAs). Falls back to
# FRONTEND_URL when unset.
# CONSOLE_URL=http://localhost:3001
# Socket.IO origin allow-list (comma-separated). Only needed when an app
# connects sockets from a different origin than FRONTEND_URL (e.g. the admin
# console). Falls back to FRONTEND_URL when unset.
# SOCKET_ALLOWED_ORIGINS=https://admin.spots.lk,https://spots.lk

# OTP signing (HMAC key for phone-verification codes) — REQUIRED
OTP_HMAC_SECRET=generate-a-long-random-string

# Google reCAPTCHA v3 (Anti-bot Check, ticket 04-06) — OPTIONAL. Until the
# secret key is set the Anti-bot Check is off (dev/test + the Booking Widget
# iframe, ADR-0042, never enforce it). Once set, the protected routes
# (Dedicated Site sign-in/register/checkout, owner-lead form) fail closed on
# missing/invalid/expired tokens. One shared site key, no per-domain
# allowlisting — the token's hostname is validated against the request origin.
# The matching public site key goes to the apps as NEXT_PUBLIC_RECAPTCHA_SITE_KEY.
# RECAPTCHA_SECRET_KEY=
# Optional score threshold (0.0-1.0, default 0.5); below it sign-in/register
# escalate to an email-OTP challenge and checkout/leads are rejected.
# RECAPTCHA_MIN_SCORE=0.5

# Supabase Storage (venue photos, ADR-0010) — REQUIRED. Boot fails without these.
# Find them at Supabase dashboard → Settings → API Keys (new sb_* format).
# The service-role (secret) key is server-side only — never expose to the browser.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_SERVICE_ROLE_KEY
# Optional: bucket for venue photos (created + made public at boot if missing).
# SUPABASE_STORAGE_BUCKET=venue_images

# PayHere (payments) — REQUIRED. Boot fails without these (no public fallbacks).
PAYHERE_MERCHANT_ID=YOUR_MERCHANT_ID
PAYHERE_MERCHANT_SECRET=YOUR_MERCHANT_SECRET
PAYHERE_CHECKOUT_URL=https://sandbox.payhere.lk/pay/checkout
# Public URL of THIS API (for PayHere notify webhook). Set when the API origin
# differs from FRONTEND_URL. Leave unset to fall back to FRONTEND_URL.
# API_PUBLIC_URL=https://api.spots.lk
# PAYHERE_NOTIFY_URL=https://api.spots.lk/api/v1/payments/payhere/notify
# PAYHERE_AUTHORIZATION=Bearer token for PayHere refunds (api/v1, merchant)
